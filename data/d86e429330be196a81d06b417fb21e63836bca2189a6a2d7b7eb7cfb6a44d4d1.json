{"data": {"getFormFlowBySlug": {"success": true, "message": null, "data": {"id": "2b21b593-7bea-4ca9-b641-22f1eaf97cb9", "slug": "newsletter-signup", "description": "Site-wide newsletter signup (DEVC-4108). Replaces the HubSpot script embed in the footer, the Subscribe here modal and newsletter overlay campaigns, and mirrors that form field for field: email, first/last name, the student-or-parent question and graduation year. Selected explicitly by slug from the embed configuration, never by path. whoIsSigning carries what the HubSpot form called booking_type, and is required rather than optional as it was there: the generic email/firstName/lastName pseudo-fields are only written onto the entry once whoIsSigning is known, so leaving it blank would persist and forward nothing at all.", "isActive": true, "isDefault": false, "pathPatterns": [], "createdAt": "2026-09-21T18:46:12.978Z", "updatedAt": "2026-09-21T18:46:12.978Z", "flowDefinition": {"startNodeId": "start", "metadata": {"requiredFlowFields": ["whoIsSigning", "email"], "showProgress": false, "consentExemptFieldIds": null, "__typename": "FormFlowMetadata"}, "nodes": [{"id": "start", "internalName": "Start", "type": "START", "internalDescription": "Flow start point", "externalHeader": "", "externalSubHeader": "", "nextNodeId": "newsletterForm", "displayConfig": null, "preventPreviousAction": null, "__typename": "StartNodeConfig"}, {"id": "newsletterForm", "internalName": "Newsletter Signup", "type": "FORM", "internalDescription": "Field-for-field equivalent of the HubSpot Newsletter Footer Form. Every surface that renders this flow supplies its own heading — the footer column heading comes from the design system, the modal and overlay headings from the authored block — so the node carries no external copy of its own. All fields are FULL width: the footer newsletter column is the narrowest surface this renders in, and a half-width field there is unusable.", "externalHeader": "", "externalSubHeader": "", "nextNode